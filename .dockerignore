# Git.
.git
.gitignore
.gitattributes

# Temporary files.
/tmp/*
!/tmp/.keep
!/tmp/pids
/log/*
!/log/.keep
/storage/*
!/storage/.keep

# Bundler and compiled assets — rebuilt inside the image.
/.bundle
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Secrets: the master key is injected at run time via RAILS_MASTER_KEY.
/config/master.key
/config/credentials/*.key

# Tests and editor config.
/test
/.idea
/.ruby-lsp
.DS_Store
