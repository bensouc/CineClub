#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
  export LD_PRELOAD
fi

# Schema changes are the deploy's release_command (see fly.toml), not every
# machine boot: with auto_stop_machines every cold start would otherwise pay for
# a second full Rails boot, and concurrent machines would race each other.
exec "${@}"
