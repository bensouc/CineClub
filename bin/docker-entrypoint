#!/bin/bash -e

# Entrypoint du conteneur.
#
# Les migrations ne sont PAS lancées ici : elles tournent via la commande
# pre-deploy de Coolify (`./bin/rails db:prepare`), pour ne s'exécuter qu'une
# fois par déploiement plutôt qu'à chaque démarrage de conteneur.
#
# Un pidfile hérité d'un conteneur tué brutalement empêcherait Puma de
# redémarrer ("A server is already running"), d'où le nettoyage.
rm -f tmp/pids/server.pid

exec "${@}"
