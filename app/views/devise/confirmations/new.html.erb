<%= render layout: "devise/shared/auth_page", locals: { title: "Renvoyer la confirmation" } do %>
  <%= form_with model: resource, as: resource_name, url: confirmation_path(resource_name),
                method: :post, class: "space-y-4" do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= render "shared/field", form: f, name: :email, label: "Email", type: :email,
                               options: { autofocus: true, required: true,
                                          value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) } %>
    <%= f.submit "Renvoyer les instructions",
                 class: "w-full rounded-xl bg-marquee px-4 py-3.5 text-base font-bold text-marquee-ink shadow-sm transition hover:brightness-95" %>
  <% end %>
<% end %>
