<%= render layout: "devise/shared/auth_page", locals: { title: "Mot de passe oublié" } do %>
  <%= form_with model: resource, as: resource_name, url: password_path(resource_name),
                method: :post, class: "space-y-4" do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= render "shared/field", form: f, name: :email, label: "Email", type: :email,
                               options: { autofocus: true, required: true },
                               hint: "Nous vous enverrons un lien de réinitialisation." %>
    <%= f.submit "Envoyer le lien",
                 class: "w-full rounded-xl bg-marquee px-4 py-3.5 text-base font-bold text-marquee-ink shadow-sm transition hover:brightness-95" %>
  <% end %>
<% end %>
