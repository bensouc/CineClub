<%= render layout: "devise/shared/auth_page", locals: { title: "Nouveau mot de passe" } do %>
  <%= form_with model: resource, as: resource_name, url: password_path(resource_name),
                method: :put, class: "space-y-4" do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <%= render "shared/field", form: f, name: :password, label: "Nouveau mot de passe", type: :password,
                               options: { autofocus: true, required: true, autocomplete: "new-password" },
                               hint: (@minimum_password_length ? "#{@minimum_password_length} caractères minimum" : nil) %>
    <%= render "shared/field", form: f, name: :password_confirmation, label: "Confirmation", type: :password,
                               options: { required: true, autocomplete: "new-password" } %>
    <%= f.submit "Changer mon mot de passe",
                 class: "w-full rounded-xl bg-marquee px-4 py-3.5 text-base font-bold text-marquee-ink shadow-sm transition hover:brightness-95" %>
  <% end %>
<% end %>
