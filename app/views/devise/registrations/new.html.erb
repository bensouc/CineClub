<%= render layout: "devise/shared/auth_page", locals: { title: "Créer un compte" } do %>
  <%= form_with model: resource, as: resource_name, url: registration_path(resource_name),
                class: "space-y-4" do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= render "shared/field", form: f, name: :email, label: "Email", type: :email,
                               options: { autofocus: true, required: true } %>
    <%= render "shared/field", form: f, name: :password, label: "Mot de passe", type: :password,
                               options: { required: true, autocomplete: "new-password" },
                               hint: (@minimum_password_length ? "#{@minimum_password_length} caractères minimum" : nil) %>
    <%= render "shared/field", form: f, name: :password_confirmation, label: "Confirmation", type: :password,
                               options: { required: true, autocomplete: "new-password" } %>
    <%= f.submit "Créer mon compte",
                 class: "w-full rounded-xl bg-marquee px-4 py-3.5 text-base font-bold text-marquee-ink shadow-sm transition hover:brightness-95" %>
  <% end %>
<% end %>
