<%= render layout: "devise/shared/auth_page", locals: { title: "Mon compte" } do %>
  <%= form_with model: resource, as: resource_name, url: registration_path(resource_name),
                method: :put, class: "space-y-4" do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= render "shared/field", form: f, name: :email, label: "Email", type: :email,
                               options: { autofocus: true, required: true } %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <%= tag.p "En attente de confirmation pour #{resource.unconfirmed_email}", class: "text-sm text-muted" %>
    <% end %>

    <%= render "shared/field", form: f, name: :password, label: "Nouveau mot de passe", type: :password,
                               options: { autocomplete: "new-password" },
                               hint: "Laissez vide pour ne pas le changer." %>
    <%= render "shared/field", form: f, name: :password_confirmation, label: "Confirmation", type: :password,
                               options: { autocomplete: "new-password" } %>
    <%= render "shared/field", form: f, name: :current_password, label: "Mot de passe actuel", type: :password,
                               options: { required: true, autocomplete: "current-password" },
                               hint: "Nécessaire pour confirmer les changements." %>
    <%= f.submit "Mettre à jour",
                 class: "w-full rounded-xl bg-marquee px-4 py-3.5 text-base font-bold text-marquee-ink shadow-sm transition hover:brightness-95" %>
  <% end %>

  <%= tag.div class: "mt-10 border-t border-line pt-6" do %>
    <%= link_to registration_path(resource_name),
                data: { turbo_method: :delete, turbo_confirm: "Supprimer définitivement votre compte ?" },
                class: "flex items-center justify-center gap-2 rounded-xl border border-curtain/30 px-4 py-3 text-sm font-semibold text-curtain transition hover:bg-curtain/5" do %>
      <%= icon :trash, size: "size-4" %>
      Supprimer mon compte
    <% end %>
  <% end %>
<% end %>
