<%# Shared shell for every auth page except the sign-in landing. %>
<%= tag.div class: "py-10" do %>
  <%= tag.header do %>
    <%= tag.h1 title, class: "text-4xl leading-none" %>
    <%= tag.div class: "film-strip mt-4 h-3.5 rounded-full" %>
  <% end %>

  <%= tag.div class: "mt-6" do %>
    <%= yield %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
