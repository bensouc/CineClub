<% if resource.errors.any? %>
  <%= tag.div role: "alert",
              class: "mb-4 rounded-xl border border-curtain/25 bg-curtain/5 p-4 text-sm text-curtain" do %>
    <%= tag.p pluralize(resource.errors.count, "erreur empêche", plural: "erreurs empêchent") +
              " l'enregistrement :", class: "font-semibold" %>
    <%= tag.ul class: "mt-1 list-inside list-disc" do %>
      <% resource.errors.full_messages.each do |message| %>
        <%= tag.li message %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
