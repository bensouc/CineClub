<% links = [] %>
<% links << ["Se connecter", new_session_path(resource_name)] if controller_name != "sessions" %>
<%# No "create an account" link on purpose: sign-up is invitation-only. %>
<% links << ["Mot de passe oublié ?", new_password_path(resource_name)] if devise_mapping.recoverable? && !%w[passwords registrations].include?(controller_name) %>
<% links << ["Renvoyer les instructions de confirmation", new_confirmation_path(resource_name)] if devise_mapping.confirmable? && controller_name != "confirmations" %>
<% links << ["Renvoyer les instructions de déblocage", new_unlock_path(resource_name)] if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>

<% if links.any? %>
  <%= tag.nav class: "mt-6 flex flex-col items-center gap-2.5 text-sm" do %>
    <% links.each do |label, path| %>
      <%= link_to label, path, class: "font-semibold text-marquee-ink underline-offset-4 hover:underline" %>
    <% end %>
  <% end %>
<% end %>

<% if devise_mapping.omniauthable? %>
  <%= tag.nav class: "mt-4 flex flex-col items-center gap-2 text-sm" do %>
    <% resource_class.omniauth_providers.each do |provider| %>
      <%= link_to "Se connecter avec #{OmniAuth::Utils.camelize(provider)}",
                  omniauth_authorize_path(resource_name, provider),
                  data: { turbo_method: :post },
                  class: "font-semibold text-marquee-ink underline-offset-4 hover:underline" %>
    <% end %>
  <% end %>
<% end %>
