<%= tag.section id: "search-bar", class: "mt-10",
                data: {
                  controller: "movie-search",
                  movie_search_search_url_value: movies_search_path,
                  movie_search_add_url_value: event_choices_path(event)
                } do %>
  <%= tag.h2 "Ajouter un film", class: "text-2xl leading-none" %>

  <%= form_with url: movies_search_path, method: :get,
                data: { action: "movie-search#search" }, class: "mt-3" do %>
    <%= tag.div class: "flex gap-2" do %>
      <%= tag.input type: "search", placeholder: "Titre du film", "aria-label": "Rechercher un film",
                    data: { movie_search_target: "query" },
                    class: "h-12 min-w-0 flex-1 rounded-xl border border-line bg-card px-4 text-base " \
                           "placeholder:text-muted focus:border-marquee focus:outline-none " \
                           "focus:ring-2 focus:ring-marquee/30" %>
      <%= tag.button type: "submit", "aria-label": "Rechercher",
                     class: "flex size-12 shrink-0 items-center justify-center rounded-xl bg-marquee " \
                            "text-marquee-ink shadow-sm transition hover:brightness-95" do %>
        <%= icon :search, size: "size-5" %>
      <% end %>
    <% end %>
  <% end %>

  <%= tag.ul data: { movie_search_target: "results" }, class: "mt-4 grid grid-cols-3 gap-3" %>
<% end %>
