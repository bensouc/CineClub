<%= tag.header class: "pt-8 pb-6" do %>
  <%= tag.h1 title, class: "text-4xl leading-none" %>
  <%= tag.div class: "film-strip mt-4 h-3.5 rounded-full" %>
<% end %>

<%= form_with model: event, class: "space-y-5" do |f| %>
  <% if event.errors.any? %>
    <%= tag.div role: "alert",
                class: "rounded-xl border border-curtain/25 bg-curtain/5 p-4 text-sm text-curtain" do %>
      <%= tag.p pluralize(event.errors.count, "erreur empêche", plural: "erreurs empêchent") + " l'enregistrement :",
                class: "font-semibold" %>
      <%= tag.ul class: "mt-1 list-inside list-disc" do %>
        <% event.errors.full_messages.each do |message| %>
          <%= tag.li message %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render "shared/field", form: f, name: :name, label: "Nom de la soirée",
                             type: :text, options: { autofocus: true, placeholder: "Soirée SF" } %>

  <%# Native date input: on mobile this opens the OS picker, which beats any
      JavaScript calendar and keeps the app free of third-party scripts. %>
  <%= render "shared/field", form: f, name: :date, label: "Date", type: :date %>

  <%# Interrupteur Tailwind : un checkbox masqué (coché = extérieur), la piste et
      la pastille (::after) réagissent via peer-checked. Le libellé bascule aussi. %>
  <%= tag.div do %>
    <%= tag.span "Lieu", class: "mb-1.5 block text-sm font-semibold text-muted" %>
    <%= f.label :venue, class: "flex cursor-pointer items-center justify-between gap-3 " \
                               "rounded-xl border border-line bg-card py-3 pl-4 pr-3" do %>
      <%= f.check_box :venue, { class: "peer sr-only" }, "outdoor", "indoor" %>

      <%= tag.span class: "flex items-center gap-2 font-semibold text-marquee-ink peer-checked:hidden" do %>
        <%= icon :sofa, size: "size-4" %>
        Salle Canapé
      <% end %>
      <%= tag.span class: "hidden items-center gap-2 font-semibold text-marquee-ink peer-checked:flex" do %>
        <%= icon :palm, size: "size-4" %>
        Salle Pelouse
      <% end %>

      <%= tag.span class: "relative h-6 w-11 shrink-0 rounded-full bg-line transition-colors " \
                          "peer-checked:bg-marquee after:absolute after:left-0.5 after:top-0.5 " \
                          "after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow " \
                          "after:transition-transform after:content-[''] peer-checked:after:translate-x-5" %>
    <% end %>
  <% end %>

  <%= tag.div class: "flex items-center gap-3 pt-2" do %>
    <%= f.submit submit_label,
                 class: "flex-1 rounded-xl bg-marquee px-4 py-3 font-bold text-marquee-ink " \
                        "shadow-sm transition hover:brightness-95" %>
    <%= link_to "Annuler", events_path,
                class: "rounded-xl border border-line px-4 py-3 font-semibold text-muted " \
                       "transition hover:bg-card hover:text-ink" %>
  <% end %>
<% end %>

<% if event.persisted? %>
  <%= tag.div class: "mt-10 border-t border-line pt-6" do %>
    <%= link_to event_path(event),
                data: { turbo_method: :delete, turbo_confirm: "Supprimer la soirée et tous ses films ?" },
                class: "flex items-center justify-center gap-2 rounded-xl border border-curtain/30 " \
                       "px-4 py-3 text-sm font-semibold text-curtain transition hover:bg-curtain/5" do %>
      <%= icon :trash, size: "size-4" %>
      Supprimer cette soirée
    <% end %>
  <% end %>
<% end %>
