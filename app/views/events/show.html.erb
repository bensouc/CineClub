<div class="d-flex flex-column p-4">
  <div class="title"  >
    <%unless @event.name.nil?  %>
      <h1><%=@event.name%></h1>
    <% end %>
    <h1><%=I18n.l(@event.date, format: :long, locale: "fr")%></h1>
    <% if admin? %>
      <%= link_to "Modifier la soirée", edit_event_path(@event), class: "btn btn-sm btn-outline-light" %>
    <% end %>
  </div>
  <div class="choices" >
    <% @choices.each do |choice| %>
      <div class="cardandoanwer" >
        <div class='movie-detailed-card' data-controller="display-names" >
          <div class="details" >
            <!-- Button trigger modal -->
            <button type="button" class="details" data-bs-toggle="modal" data-bs-target="#staticBackdrop-<%=choice.id%>">
              <div class="left">
                <% if choice.movie.trailer_url.nil? %>
                  <div class="empty"></div>
                <% else %>
                  <%= link_to  choice.movie.trailer_url, target: 'blank', class: "trailer_url" do %>
                    <i class="fa-solid fa-film"></i>
                  <% end %>
                <% end %>
              </div>
              <div class='event-poster'>
                <%= image_tag choice.movie.poster_url %>
              </div>
            </button>
            <!-- Modal -->
            <div class="modal fade" id="staticBackdrop-<%=choice.id%>"  tabindex="-1" aria-labelledby="staticBackdrop-<%=choice.id%>Label" aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdrop-<%=choice.id%>Label">Description : <%=choice.movie.title%></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <%= choice.movie.overview %>
                  </div>
                  <%# <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Understood</button>
                  </div> %>
                </div>
              </div>
            </div>
          </div>
          <div class="vote-logo">
            <% if @voted_choice_ids.exclude?(choice.id) %>
              <%= link_to event_vote_path(@event, choice), data: { turbo_method: :post } do %>
                <i class="fa-solid fa-circle-plus"></i>
              <% end %>
            <% end %>
          </div>
          <div class="vote-score" >
            <div class="choice-ranking-display" <%= "data-action=click->display-names#displayVotes" if choice.ranking > 0 %>>
              <%=choice.ranking%>
            </div>
            <div class="show-votes d-none"  data-display-names-target="votes" data-action='click->display-names#hideVotes'>
              <i class="fa-solid fa-circle-xmark"></i>
              <h4>Votant<%= "s" if choice.votes.size > 1  %> :</h4>
              <% choice.votes.each do |vote|%>
                <h5>
                  <li>
                    <%= vote.user.email.split('@').first.capitalize %>
                  </li>
                </h5>
              <% end %>
            </div>
          </div>
          <div class="unvote-logo">
            <% if @voted_choice_ids.include?(choice.id) %>
              <%= link_to event_unvote_path(@event, choice), data: { turbo_method: :delete, turbo_confirm: "Voulez vous retirer votre vote?" } do %>
                <i class="fa-solid fa-circle-minus"></i>
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="choice-owner">
          <div class="owner-name">
            Proposé par <%=choice.user.email.split('@').first.capitalize%>
            <% if choice.user == current_user %>
              <%= link_to choice_path(choice), data: { turbo_method: :delete, turbo_confirm: "Voulez vous retirer ce film?" } do %>
                <i class="fa-solid fa-trash ms-2"></i>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="search-bar" id="search-bar"
       data-controller="movie-search"
       data-movie-search-search-url-value="<%= movies_search_path %>"
       data-movie-search-add-url-value="<%= event_choices_path(@event) %>">
    <form data-action="movie-search#search">
      <div class="search-form-control form-group">
        <input class="form-control string required" type="text" placeholder="Titre"
               aria-label="Rechercher un film"
               data-movie-search-target="query">
        <button type="submit" class="btn btn-flat mb-4" aria-label="Rechercher">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>
    </form>
    <ul class="choices" data-movie-search-target="results">
      <%# Search results are rendered here by movie_search_controller.js %>
    </ul>
  </div>
</div>
<div class="footer">
</div>
