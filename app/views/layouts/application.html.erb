<%= "<!DOCTYPE html>".html_safe %>
<%= tag.html lang: "fr" do %>
  <%= tag.head do %>
    <%= tag.title "Ciné Club" %>
    <%= tag.meta name: "viewport", content: "width=device-width, initial-scale=1, viewport-fit=cover" %>
    <%= tag.meta name: "theme-color", content: "#faf8f4" %>
    <%= tag.meta name: "apple-mobile-web-app-capable", content: "yes" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= favicon_link_tag "/apple-icon-180x180.png", rel: "apple-touch-icon", sizes: "180x180" %>
    <%= favicon_link_tag "/favicon-32x32.png", type: "image/png", sizes: "32x32" %>
    <%= favicon_link_tag "/favicon-16x16.png", type: "image/png", sizes: "16x16" %>
    <%= tag.link rel: "manifest", href: "/manifest.json" %>

    <%= tag.link rel: "preconnect", href: "https://fonts.googleapis.com" %>
    <%= tag.link rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true %>
    <%= tag.link rel: "stylesheet",
                 href: "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Urbanist:wght@400;500;600;700&display=swap" %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  <% end %>

  <%= tag.body class: "antialiased" do %>
    <%= tag.main class: "mx-auto w-full max-w-screen-sm px-4" do %>
      <%= render "shared/flashes" %>
      <%= yield %>
    <% end %>

    <% unless current_user.nil? %>
      <%= tag.nav "aria-label": "Navigation principale",
                  class: "fixed inset-x-0 bottom-0 z-40 border-t border-line bg-card/95 " \
                         "backdrop-blur pb-[env(safe-area-inset-bottom)]" do %>
        <%= tag.div class: "mx-auto flex max-w-screen-sm items-center justify-around px-4 py-3" do %>
          <%= render "shared/nav_link", path: events_path, name: :list, label: "Soirées" %>
          <% if admin? %>
            <%= render "shared/nav_link", path: new_event_path, name: :plus, label: "Nouvelle", accent: true %>
            <%= render "shared/nav_link", path: invitations_path, name: :ticket, label: "Inviter" %>
          <% end %>
          <%= render "shared/nav_link", path: destroy_user_session_path, name: :logout,
                                        label: "Sortir", method: :delete %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
